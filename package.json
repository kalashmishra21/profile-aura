{
  "name": "profile-aura",
  "version": "3.0.0",
  "description": "Next-Gen SVG-First GitHub README Generator, with Satori Anime-Inspired Hero Cards, Token-Based Themes, and Modular Widgets.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "profile-aura": "./dist/cli/index.js"
  },
  "files": [
    "dist/",
    "assets/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalashmishra21/profile-aura.git"
  },
  "homepage": "https://github.com/kalashmishra21/profile-aura",
  "bugs": {
    "url": "https://github.com/kalashmishra21/profile-aura/issues"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli/index.js",
    "generate": "node dist/cli/index.js build",
    "init": "node dist/cli/index.js init",
    "themes": "node dist/cli/index.js themes",
    "preview": "node dist/cli/index.js preview",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "npm run build && node dist/cli/index.js build --dry-run"
  },
  "keywords": [
    "github",
    "readme",
    "generator",
    "svg",
    "satori",
    "profile",
    "anime",
    "editorial",
    "dark-mode",
    "portfolio",
    "themes",
    "widgets",
    "typescript",
    "cli"
  ],
  "author": "Kalash Mishra <kalashji21@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@octokit/rest": "^20.0.2",
    "commander": "^11.1.0",
    "dotenv": "^16.6.1",
    "react": "^18.2.0",
    "satori": "^0.10.14",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.45",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
